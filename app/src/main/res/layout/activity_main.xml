<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 简约卡通风背景：支持日间/夜间模式渐变与动态星星 -->
    <com.olsc.a2048.CartoonBackgroundView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <!-- 顶部：标题 + 得分/最佳卡 + 关于 + 日夜模式切换 + 新游戏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="2048"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.olsc.a2048.CartoonCardView
                android:id="@+id/scoreCard"
                android:layout_width="60dp"
                android:layout_height="56dp"
                android:layout_marginEnd="4dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/scoreLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/score_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/scoreValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />
                </LinearLayout>
            </com.olsc.a2048.CartoonCardView>

            <com.olsc.a2048.CartoonCardView
                android:id="@+id/bestCard"
                android:layout_width="60dp"
                android:layout_height="56dp"
                android:layout_marginEnd="4dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/bestLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/best_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/bestValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />
                </LinearLayout>
            </com.olsc.a2048.CartoonCardView>

            <!-- 关于按钮 -->
            <com.olsc.a2048.CartoonCardView
                android:id="@+id/aboutBtn"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="ℹ️"
                    android:textSize="18sp" />
            </com.olsc.a2048.CartoonCardView>

            <!-- 模式切换按钮：☀️ 日间 / 🌙 夜间 -->
            <com.olsc.a2048.CartoonCardView
                android:id="@+id/themeToggleBtn"
                android:layout_width="44dp"
                android:layout_height="56dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/themeToggleText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="☀️"
                    android:textSize="18sp" />
            </com.olsc.a2048.CartoonCardView>

            <com.olsc.a2048.CartoonCardView
                android:id="@+id/newGameBtn"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/newGameBtnText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/new_game"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </com.olsc.a2048.CartoonCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint_swipe"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.olsc.a2048.CartoonCardView
            android:id="@+id/boardGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:padding="10dp">

            <com.olsc.a2048.BoardView
                android:id="@+id/board"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </com.olsc.a2048.CartoonCardView>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 关于页面 遮罩弹窗 -->
    <FrameLayout
        android:id="@+id/aboutOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.olsc.a2048.CartoonCardView
            android:id="@+id/aboutCard"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_foreground" />

                <TextView
                    android:id="@+id/aboutTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/about_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/aboutAuthorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/about_author"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- 开源项目 URL 链接 -->
                <TextView
                    android:id="@+id/aboutLinkText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/about_link"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp" />

                <com.olsc.a2048.CartoonCardView
                    android:id="@+id/aboutCloseBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="32dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/aboutCloseBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/about_close"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.olsc.a2048.CartoonCardView>
            </LinearLayout>
        </com.olsc.a2048.CartoonCardView>
    </FrameLayout>

    <!-- 游戏结束 / 胜利遮罩 -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.olsc.a2048.CartoonCardView
            android:id="@+id/overlayCard"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overlayTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/overlayMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.olsc.a2048.CartoonCardView
                        android:id="@+id/overlayPrimaryBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="26dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="26dp"
                        android:paddingBottom="13dp">

                        <TextView
                            android:id="@+id/overlayPrimaryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />
                    </com.olsc.a2048.CartoonCardView>

                    <com.olsc.a2048.CartoonCardView
                        android:id="@+id/overlaySecondaryBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="22dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="13dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/overlaySecondaryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/keep_going"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />
                    </com.olsc.a2048.CartoonCardView>
                </LinearLayout>
            </LinearLayout>
        </com.olsc.a2048.CartoonCardView>
    </FrameLayout>
</FrameLayout>
